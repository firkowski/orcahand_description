	<default>
		<geom type="mesh" friction="1 0.005 0.001" condim="3" margin="0.0005" contype="1" conaffinity="1" />
		<joint type="hinge" limited="true" damping="0.1" armature="0.001" margin="0.01" frictionloss="0.001" />
		<position ctrllimited="true" forcelimited="true" forcerange="-1 1" kp="2.0" />
		<mesh scale="0.001 0.001 0.001" />
		<!-- Collision: simplified convex hulls (utils/make_collision_hulls.py), massless; inertia comes from the visual geoms -->
		<default class="left_collision">
			<geom type="mesh" contype="1" conaffinity="1" condim="3" group="3" mass="0" friction="1.0 0.005 0.0001" margin="0" rgba="0.9 0.45 0.2 1" />
			<default class="left_collision_skin">
				<geom rgba="0.2 0.6 0.9 1" />
			</default>
		</default>
	</default>
